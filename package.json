{
  "name": "cbt-backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm --filter @cbt-bo/config build",
    "dev": "turbo run dev",
    "dev:so": "pnpm --filter backoffice dev:so",
    "dev:fm": "pnpm --filter backoffice dev:fm",
    "storybook": "turbo run storybook",
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "check:types": "turbo run check:types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "tidy": "turbo run format lint:fix",
    "tidy:app": "turbo run format lint:fix check:types --filter=backoffice"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@upstash/context7-mcp": "^2.2.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "mcp-jira-stdio": "^1.9.0",
    "prettier": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
