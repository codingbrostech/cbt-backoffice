{
  "name": "cbt-backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm --filter @cbt-bo/config build && pnpm --filter @cbt-bo/api-schema build",
    "dev": "turbo run dev",
    "dev:so": "turbo run dev --filter=so-backoffice",
    "dev:fm": "turbo run dev --filter=fm-backoffice",
    "storybook": "turbo run storybook",
    "storybook:lib": "turbo run storybook --filter=@cbt-bo/component-lib",
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "gen:api": "turbo run gen:api:build",
    "gen:api:bo:fm": "turbo run gen:api:build:bo-fm",
    "gen:api:bo:so": "turbo run gen:api:build:bo-so",
    "check:types": "turbo run check:types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "tidy": "turbo run format lint:fix",
    "tidy:so": "turbo run format lint:fix check:types --filter=so-backoffice",
    "tidy:fm": "turbo run format lint:fix check:types --filter=fm-backoffice"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@upstash/context7-mcp": "^2.2.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "mcp-jira-stdio": "^1.9.0",
    "prettier": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
