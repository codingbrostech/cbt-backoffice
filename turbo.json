{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [".output/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "check:types": {
      "dependsOn": ["^build", "^check:types"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "format": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    }
  }
}
