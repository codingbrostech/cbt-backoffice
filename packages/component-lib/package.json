{
  "name": "@cbt-bo/component-lib",
  "private": true,
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./forms/*": "./src/forms/*.tsx"
  },
  "scripts": {
    "storybook": "storybook dev -p 6008",
    "build:storybook": "storybook build",
